{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxDB datasource for JMeter metrics",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "Active Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "drawStyle": "line",
            "pointSize": 3,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "query": "SELECT mean(\"meanAT\") AS \"Mean Threads\", mean(\"minAT\") AS \"Min Threads\", mean(\"maxAT\") AS \"Max Threads\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "Throughput (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "query": "SELECT sum(\"count\") / $__interval_ms * 1000 AS \"Throughput\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" = 'all' AND $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "Response Times (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p90" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Avg" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "query": "SELECT mean(\"avg\") AS \"Avg\", mean(\"pct90.0\") AS \"p90\", mean(\"pct95.0\") AS \"p95\", mean(\"pct99.0\") AS \"p99\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" = 'all' AND $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "drawStyle": "bars",
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "query": "SELECT sum(\"countError\") AS \"Errors\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" = 'all' AND $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "Response Times by Sampler",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "query": "SELECT mean(\"avg\") FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" != 'all' AND $timeFilter GROUP BY time($__interval), \"statut\" fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "short" },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "query": "SELECT sum(\"count\") AS \"Total\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "Total Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "query": "SELECT sum(\"countError\") AS \"Errors\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "Avg Response Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] }, "unit": "ms" },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [
        {
          "query": "SELECT mean(\"avg\") AS \"Avg\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "title": "p99 Response Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 5000 }] }, "unit": "ms" },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [
        {
          "query": "SELECT mean(\"pct99.0\") AS \"p99\" FROM \"jmeter\" WHERE \"application\" =~ /^$testTitle$/ AND \"statut\" = 'all' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["jmeter", "kubeblast", "load-testing"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "includeAll": false,
        "label": "Job ID",
        "multi": false,
        "name": "testTitle",
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "refresh": 2,
        "sort": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Kubeblast - JMeter Load Test",
  "uid": "kubeblast-jmeter",
  "version": 1
}
