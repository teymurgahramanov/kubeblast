apiVersion: batch/v1
kind: Job
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
spec:
  template:
    spec:
      containers:
      - name: {{ name }}
        image: busybox
        command: ["cat", "/tmp/{{ file_name }}"]
        volumeMounts:
        - name: config-volume
          mountPath: /tmp/{{ file_name }}
          subPath: {{ file_name }}
      restartPolicy: Never
      volumes:
      - name: config-volume
        configMap:
          name: {{ name }}
