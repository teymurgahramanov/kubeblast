<?xml version="1.0" encoding="UTF-8"?>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Simple HTTP Test Plan" enabled="true">
  <stringProp name="TestPlan.comments">This is a simple test plan to simulate HTTP requests</stringProp>
  <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"/>
  <boolProp name="TestPlan.functional_mode">false</boolProp>
  <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
  <stringProp name="TestPlan.serialize_threadgroups">false</stringProp>
  <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group" enabled="true">
    <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
    <stringProp name="ThreadGroup.num_threads">10</stringProp> <!-- Number of virtual users -->
    <stringProp name="ThreadGroup.ramp_time">10</stringProp> <!-- Time to ramp up threads -->
    <stringProp name="ThreadGroup.loops">1</stringProp> <!-- Number of loops to execute -->
    <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
      <boolProp name="LoopController.continue_forever">false</boolProp>
      <stringProp name="LoopController.loops">1</stringProp>
    </elementProp>
    <Sampler guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request" enabled="true">
      <stringProp name="HTTPSampler.domain">www.example.com</stringProp> <!-- Target domain -->
      <stringProp name="HTTPSampler.port">80</stringProp> <!-- Port -->
      <stringProp name="HTTPSampler.protocol">http</stringProp> <!-- Protocol -->
      <stringProp name="HTTPSampler.path">/</stringProp> <!-- Path -->
      <stringProp name="HTTPSampler.method">GET</stringProp> <!-- Request Method -->
    </Sampler>
    <Listener guiclass="ViewResultsTree" testclass="ViewResultsTree" testname="View Results Tree" enabled="true"/>
    <Listener guiclass="SummaryReport" testclass="SummaryReport" testname="Summary Report" enabled="true"/>
  </ThreadGroup>
</TestPlan>